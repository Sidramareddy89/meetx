# dependencies
node_modules/

# build output
dist/

# environment / secrets (VITE_* keys are bundled into the client — never commit)
.env
.env.local
.env.*.local

# stray typecheck artifact (use `npx tsc --noEmit` instead)
tsc_check.txt

# dev / preview / tunnel logs (redirects from npm run dev, npm run preview, ngrok)
*.log
*.err
build.out.log
build.err.log

# transient harness bundles (created and deleted by tools/run-*.mjs)
tools/.*.tmp.mjs

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db