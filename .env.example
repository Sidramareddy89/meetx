# MEETX environment template - copy to `.env` and fill in your own values.
# Only variables prefixed with VITE_ reach the browser bundle. This is a
# web-only build: there is no desktop/native client and no native OAuth client id.

# --- Firebase (optional) ---------------------------------------------------
# Leave blank to run in demo mode: auth and meetings are kept in localStorage.
# Fill every value to switch auth, Firestore and Storage to a real project.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Optional: App Check (reCAPTCHA v3 site key). Blank = App Check disabled.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# --- AI providers (optional) ----------------------------------------------
# The live answer pipeline tries each provider/model in order and jumps to the
# next on failure; when every provider fails the assistant returns nothing
# rather than inventing a meeting answer.
#
# WARNING: VITE_* values are compiled into the client bundle, so anything set
# here is publicly readable in `dist/assets/*.js`. The browser also accepts the
# same keys at runtime from localStorage (`meetx_gemini_api_key`,
# `meetx_groq_api_key`), which keeps them out of the build.
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
# Optional comma-separated model fallback chains (defaults live in llmProviders.ts).
VITE_GEMINI_MODELS=
VITE_GROQ_MODELS=
